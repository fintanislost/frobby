<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Consumed by both Harness (net6.0, SMAPI runtime) and Runner (net8.0+).
      net6.0 is the compatibility floor; net8.0 consumers can bind to it cleanly.
    -->
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>SdvTestFramework.Protocol</RootNamespace>
    <AssemblyName>SdvTestFramework.Protocol</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>SdvTestFramework.Protocol</PackageId>
    <Description>JSON-RPC types and Stardew Valley test-framework transport. Transitive dependency of SdvTestFramework.Runner.Dsl and SdvTestFramework.Cli.</Description>
    <PackageTags>stardew-valley;testing;json-rpc</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\nuget\README-Protocol.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Protocol.Tests verifies launcher process construction without starting SDV. -->
    <InternalsVisibleTo Include="Protocol.Tests" />
  </ItemGroup>
</Project>
