<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>SdvTestFramework.Harness</RootNamespace>
    <AssemblyName>Harness</AssemblyName>
    <EnableHarmony>true</EnableHarmony>

    <!-- Do not auto-deploy or zip. Deployment is managed by scripts (scripts/deploy.sh). -->
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.3.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Protocol\Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test project needs reach into internals (e.g. DrawFilterMatcher for T11). -->
    <InternalsVisibleTo Include="Harness.Tests" />
  </ItemGroup>

  <!-- ModBuildConfig suppresses default NuGet DLL copy. Reconcile the harness output
       against the current first-party/project-reference DLLs plus resolved runtime
       dependencies so stale package DLLs don't linger after dependency graph changes. -->
  <Target Name="ReconcileHarnessRuntimeDependencies" AfterTargets="Build">
    <ItemGroup>
      <_HarnessRuntimeDependency Include="@(RuntimeCopyLocalItems)" />
      <_CurrentHarnessDll Include="$(OutDir)$(TargetFileName)" />
      <_CurrentHarnessDll Include="@(ReferenceCopyLocalPaths->'$(OutDir)%(Filename)%(Extension)')"
                          Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
      <_CurrentHarnessDll Include="@(_HarnessRuntimeDependency->'$(OutDir)%(DestinationSubPath)')" />
      <_ExistingHarnessDll Include="$(OutDir)*.dll" />
      <_StaleHarnessDll Include="@(_ExistingHarnessDll)" Exclude="@(_CurrentHarnessDll)" />
    </ItemGroup>
    <Delete Files="@(_StaleHarnessDll)" />
    <Copy SourceFiles="@(_HarnessRuntimeDependency)"
          DestinationFiles="@(_HarnessRuntimeDependency->'$(OutDir)%(DestinationSubPath)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
